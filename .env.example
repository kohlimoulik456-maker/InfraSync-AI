# PostgreSQL connection string, e.g. postgresql://user:password@localhost:5432/infrasync
DATABASE_URL=postgresql://postgres:password@localhost:5432/infrasync

# Gemini Flash API key. If left empty, the app runs in Demo AI Mode
# (deterministic mock outputs for seeded examples only).
GEMINI_API_KEY=

# Keep this configurable - do not hard-code a model id in source.
GEMINI_MODEL=gemini-1.5-flash
