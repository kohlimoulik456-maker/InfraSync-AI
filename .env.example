# PostgreSQL connection string, e.g. postgresql://user:password@localhost:5432/infrasync
DATABASE_URL=postgresql://postgres:password@localhost:5432/infrasync

# Gemini Flash API key. If left empty, the app runs in Demo AI Mode
# (deterministic mock outputs for seeded examples only).
GEMINI_API_KEY=

# Keep this configurable - do not hard-code a model id in source.
GEMINI_MODEL=gemini-1.5-flash

# Authentication. Use long random values in deployed environments.
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=replace-with-a-strong-password
AUTH_MANAGER_USERNAME=manager
AUTH_MANAGER_PASSWORD=replace-with-a-strong-password
AUTH_SUPERVISOR_USERNAME=supervisor
AUTH_SUPERVISOR_PASSWORD=replace-with-a-strong-password

# Optional bearer token for the Flutter client.
AUTH_API_KEY=
AUTH_API_ROLE=SUPERVISOR
